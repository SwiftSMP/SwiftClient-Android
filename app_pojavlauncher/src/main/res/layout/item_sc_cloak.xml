<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sc_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/sc_cloak_image"
        android:layout_width="60dp"
        android:layout_height="96dp"
        android:background="@color/sc_panel_2"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/sc_cloak_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/pixelify"
        android:textColor="@color/sc_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sc_cloak_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/sc_muted"
        android:textSize="12sp" />
</LinearLayout>
