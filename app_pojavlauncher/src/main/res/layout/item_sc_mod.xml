<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/sc_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sc_mod_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sc_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sc_mod_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen"
            android:textColor="@color/sc_orange_hi"
            android:textSize="10sp" />
    </LinearLayout>

    <Switch
        android:id="@+id/sc_mod_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:thumbTint="@color/sc_text"
        android:trackTint="@color/sc_orange" />
</LinearLayout>
