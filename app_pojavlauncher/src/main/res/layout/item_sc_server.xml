<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/sc_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/sc_server_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sc_server_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixelify"
                android:textColor="@color/sc_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sc_server_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/sc_tag"
                android:fontFamily="@font/silkscreen"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/sc_gold"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sc_server_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sc_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sc_server_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/sc_faint"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/sc_server_join"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="72dp"
        android:background="@drawable/sc_button_orange"
        android:fontFamily="@font/pixelify"
        android:stateListAnimator="@null"
        android:text="@string/sc_join"
        android:textAllCaps="false"
        android:textColor="@color/sc_ink"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
