<?xml version="1.0" encoding="utf-8"?>
<!-- SwiftClient home: Play / Servers / Mods / Cloaks panels over a bottom tab bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/sc_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- ============ PLAY ============ -->
            <LinearLayout
                android:id="@+id/sc_panel_play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sc_card_hero"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_swiftclient" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/pixelify"
                        android:text="@string/sc_ready"
                        android:textColor="@color/sc_text"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/sc_hero_sub"
                        android:textColor="@color/sc_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sc_chip_online"
                            style="@style/SwiftChip"
                            android:drawableStart="@drawable/sc_dot"
                            android:text="–" />

                        <TextView
                            android:id="@+id/sc_chip_installs"
                            style="@style/SwiftChip"
                            android:layout_marginStart="6dp"
                            android:text="–" />

                        <TextView
                            android:id="@+id/sc_chip_swiftsmp"
                            style="@style/SwiftChip"
                            android:layout_marginStart="6dp"
                            android:text="–" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sc_version_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sc_button_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        style="@style/SwiftEyebrow"
                        android:text="@string/sc_version_label" />

                    <TextView
                        android:id="@+id/sc_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pixelify"
                        android:text="@string/sc_loading"
                        android:textColor="@color/sc_text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/sc_version_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sc_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/play_button"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/sc_button_orange"
                    android:fontFamily="@font/pixelify"
                    android:stateListAnimator="@null"
                    android:text="@string/sc_play"
                    android:textColor="@color/sc_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/sc_join_swiftsmp"
                    style="@style/SwiftGhostButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:text="@string/sc_join_swiftsmp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/custom_control_button"
                        style="@style/SwiftTool"
                        android:drawableTop="@drawable/ic_menu_custom_controls"
                        android:text="@string/sc_tool_controls" />

                    <Button
                        android:id="@+id/open_files_button"
                        style="@style/SwiftTool"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_folder"
                        android:text="@string/sc_tool_folder" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/share_logs_button"
                        style="@style/SwiftTool"
                        android:drawableTop="@android:drawable/ic_menu_share"
                        android:text="@string/sc_tool_logs" />

                    <Button
                        android:id="@+id/install_jar_button"
                        style="@style/SwiftTool"
                        android:layout_marginStart="8dp"
                        android:drawableTop="@drawable/ic_menu_install_jar"
                        android:text="@string/sc_tool_jar" />
                </LinearLayout>

                <TextView
                    style="@style/SwiftEyebrow"
                    android:layout_marginTop="22dp"
                    android:text="@string/sc_other_profiles" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sc_other_profiles_hint"
                    android:textColor="@color/sc_faint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/sc_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_52sdp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableEnd="@drawable/spinner_arrow"
                        android:textColor="@color/sc_text"
                        app:drawableEndPadding="@dimen/_1sdp"
                        app:drawableEndSize="@dimen/padding_heavy"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="@dimen/_36sdp"
                        xmlns:app="http://schemas.android.com/apk/res-auto" />

                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="@dimen/_52sdp"
                        android:layout_height="@dimen/_52sdp"
                        android:background="?android:attr/selectableItemBackground"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_edit_profile" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ SERVERS ============ -->
            <LinearLayout
                android:id="@+id/sc_panel_servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/SwiftTitle" android:text="@string/sc_servers_title" />
                <TextView style="@style/SwiftSub" android:text="@string/sc_servers_sub" />

                <LinearLayout
                    android:id="@+id/sc_server_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ MODS ============ -->
            <LinearLayout
                android:id="@+id/sc_panel_mods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/SwiftTitle" android:text="@string/sc_mods_title" />
                <TextView android:id="@+id/sc_mods_sub" style="@style/SwiftSub" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/sc_add_mod"
                        style="@style/SwiftGhostButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/sc_ic_add"
                        android:text="@string/sc_add_mod" />

                    <Button
                        android:id="@+id/sc_update_mods"
                        style="@style/SwiftGhostButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/sc_update_mods" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sc_mod_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ CLOAKS ============ -->
            <LinearLayout
                android:id="@+id/sc_panel_cloaks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/SwiftTitle" android:text="@string/sc_cloaks_title" />
                <TextView style="@style/SwiftSub" android:text="@string/sc_cloaks_sub" />

                <TextView
                    android:id="@+id/sc_cloak_status"
                    style="@style/SwiftSub"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sc_orange_hi" />

                <LinearLayout
                    android:id="@+id/sc_cloak_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <!-- Bottom tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@drawable/sc_nav_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <TextView android:id="@+id/sc_tab_play" style="@style/SwiftTab" android:drawableTop="@drawable/sc_ic_play" android:text="@string/sc_tab_play" />
        <TextView android:id="@+id/sc_tab_servers" style="@style/SwiftTab" android:drawableTop="@drawable/sc_ic_servers" android:text="@string/sc_tab_servers" />
        <TextView android:id="@+id/sc_tab_mods" style="@style/SwiftTab" android:drawableTop="@drawable/sc_ic_mods" android:text="@string/sc_tab_mods" />
        <TextView android:id="@+id/sc_tab_cloaks" style="@style/SwiftTab" android:drawableTop="@drawable/sc_ic_cloak" android:text="@string/sc_tab_cloaks" />
    </LinearLayout>
</LinearLayout>
